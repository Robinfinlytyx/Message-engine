# Backend Environment Variables

# Server
PORT=5000

# Database
DATABASE_URL=postgresql://user:password@localhost:5432/communication_engine

# Redis
REDIS_HOST=localhost
REDIS_PORT=6379

# Telinfy WhatsApp Provider
TELINFY_API_KEY=your_telinfy_api_key
TELINFY_WHATSAPP_BUSINESS_ID=your_business_id

# Email Service (Nodemailer)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your-email@gmail.com
SMTP_PASSWORD=your-app-password
DEFAULT_FROM_EMAIL=noreply@yourapp.com
DEFAULT_FROM_NAME=Communication Engine

# Email Service Configuration
EMAIL_BATCH_SIZE=100
EMAIL_MAX_RETRIES=3
EMAIL_RETRY_DELAY=60000
EMAIL_WORKER_CONCURRENCY=5
EMAIL_RATE_LIMIT_MAX=100
EMAIL_RATE_LIMIT_DURATION=1000

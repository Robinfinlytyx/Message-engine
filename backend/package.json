{
  "name": "communication-engine",
  "version": "1.0.0",
  "description": "WhatsApp Message Engine using Telinfy APIs",
  "main": "dist/server.js",
  "type": "commonjs",
  "scripts": {
    "dev": "nodemon src/server.ts",
    "dev:server": "ts-node src/server.ts",
    "dev:worker": "ts-node src/worker.ts",
    "build": "tsc",
    "start": "node dist/server.js",
    "start:server": "node dist/server.js",
    "start:worker": "node dist/worker.js",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:push": "drizzle-kit push"
  },
  "keywords": [
    "whatsapp",
    "messaging",
    "telinfy"
  ],
  "author": "",
  "license": "ISC",
  "dependencies": {
    "@types/nodemailer": "^7.0.9",
    "axios": "^1.13.4",
    "bullmq": "^5.67.2",
    "cors": "^2.8.6",
    "dotenv": "^17.2.3",
    "drizzle-orm": "^0.45.1",
    "express": "^5.2.1",
    "ioredis": "^5.9.2",
    "nodemailer": "^8.0.0",
    "postgres": "^3.4.8",
    "uuid": "^13.0.0"
  },
  "devDependencies": {
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/node": "^25.2.0",
    "@types/uuid": "^10.0.0",
    "drizzle-kit": "^0.31.8",
    "nodemon": "^3.1.11",
    "ts-node": "^10.9.2",
    "typescript": "^5.9.3"
  }
}
